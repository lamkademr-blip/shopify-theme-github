<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#0e0e10">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {%- liquid
      assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold'
    -%}

    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}

      :root {
        --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-heading-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body {
        margin: 0;
        background: #0e0e10;
        color: #f5f5f5;
        font-family: var(--font-body-family), sans-serif;
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }
      img, video { max-width: 100%; display: block; }

      /* Bandeau cookies Shopify Privacy — même habillage carbone que base.css
         (base.css n'est volontairement pas chargé sur ce layout). */
      #shopify-pc__banner.shopify-pc__banner__dialog {
        font-family: var(--font-body-family), sans-serif !important;
        background: #121212 !important;
        color: #f7f6f4 !important;
        border-radius: 0 !important;
        border: none !important;
        box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.35) !important;
      }
      #shopify-pc__banner__body-title {
        font-size: 14px !important;
        font-weight: 600 !important;
        color: #ffffff !important;
        margin: 0 0 6px !important;
      }
      #shopify-pc__banner .shopify-pc__banner__body p {
        font-size: 12px !important;
        line-height: 1.45 !important;
        color: rgba(247, 246, 244, 0.7) !important;
        max-height: 70px !important;
        overflow-y: auto !important;
        margin: 0 !important;
      }
      #shopify-pc__banner .shopify-pc__banner__body a { color: #c9a96e !important; }
      #shopify-pc__banner .shopify-pc__banner__btns {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: wrap !important;
        gap: 8px !important;
        margin-top: 12px !important;
      }
      #shopify-pc__banner .shopify-pc__banner__btns button { width: auto !important; max-width: none !important; }
      #shopify-pc__banner button {
        min-height: 44px !important;
        border-radius: 0 !important;
        font-weight: 600 !important;
        letter-spacing: 0.03em !important;
        margin: 0 !important;
      }
      #shopify-pc__banner #shopify-pc__banner__btn-accept {
        order: 1 !important;
        flex: 1 1 40% !important;
        background: #ffffff !important;
        color: #121212 !important;
        border: none !important;
      }
      #shopify-pc__banner #shopify-pc__banner__btn-decline {
        order: 2 !important;
        flex: 1 1 40% !important;
        background: transparent !important;
        color: #f7f6f4 !important;
        border: 1px solid rgba(247, 246, 244, 0.45) !important;
      }
      #shopify-pc__banner #shopify-pc__banner__btn-manage-prefs {
        order: 3 !important;
        flex: 1 1 100% !important;
        background: transparent !important;
        border: none !important;
        color: rgba(247, 246, 244, 0.6) !important;
        text-decoration: underline !important;
        font-weight: 400 !important;
        min-height: 40px !important;
      }
    {% endstyle %}
  </head>

  <body>
    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- comment -%} Tracking clics WhatsApp — même contrat d'événement que layout/theme.liquid {%- endcomment -%}
    <script>
      document.addEventListener('click', function (e) {
        var link = e.target.closest('a[href*="wa.me"]');
        if (!link) return;
        var source = 'landing_tiktok';
        var section = link.closest('[data-wa-source]');
        if (section) source = 'landing_tiktok_' + section.getAttribute('data-wa-source');
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'whatsapp_click',
          whatsapp_source: source,
          page_url: window.location.pathname,
          page_title: document.title
        });
        if (typeof window.clarity === 'function') {
          window.clarity('event', 'whatsapp_click');
          window.clarity('set', 'wa_source', source);
          window.clarity('set', 'wa_page', window.location.pathname.slice(0, 60));
        }
      });
    </script>

    {% render 'whatsapp-tracking' %}
  </body>
</html>
