{% comment %}
  Tracking des clics WhatsApp (KPI n°1 du site).
  Envoie l'evenement "whatsapp_click" :
  - a GA4 (G-RC5CZ6CH3R) via une commande gtag traitee par les balises de GTM
    (meme visiteur, meme session que la visite issue de l'annonce)
  - a Google Ads en conversion directe si ADS_SEND_TO est renseigne
  - au pixel Meta si present (trackCustom WhatsAppClick)
  - dans dataLayer (exploitable par GTM si installe un jour)
{% endcomment %}
<script>
(function() {
  var MEASUREMENT_ID = 'G-RC5CZ6CH3R';
  var sent = {};

  // Libelle de l'action de conversion Google Ads « Clic WhatsApp » (balise
  // AW-16932208147), creee le 07/11/2026.
  // Vide = seul GA4 recoit le clic (import whatsapp_click).
  var ADS_SEND_TO = 'AW-16932208147/SmLMCLDiibQdEJP884k_';

  // Commande gtag poussee dans dataLayer : les balises Google chargees par
  // GTM-NM8MP8B7 la traitent avec LEUR identifiant visiteur et LEUR session,
  // donc GA4 relie le clic a la visite issue de l'annonce (gclid).
  // Avant le 07/11/2026, un hit /g/collect fait main lisait le cookie _ga,
  // absent du site : cid aleatoire, sans session -> 0 conversion importee.
  // Le consentement est gere par le Consent Mode des balises elles-memes.
  function g() { window.dataLayer = window.dataLayer || []; window.dataLayer.push(arguments); }

  function sendGoogle(href) {
    try {
      var ref = typeof window.lavWaRef === 'function' ? window.lavWaRef() : '';
      g('event', 'whatsapp_click', {
        send_to: MEASUREMENT_ID,
        link_url: href.slice(0, 400),
        page_path: location.pathname,
        wa_ref: ref,
        transport_type: 'beacon'
      });
      if (ADS_SEND_TO) {
        g('event', 'conversion', {
          send_to: ADS_SEND_TO,
          value: 40,
          currency: 'EUR',
          transport_type: 'beacon'
        });
      }
    } catch (e) {}
  }

  document.addEventListener('click', function(e) {
    var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
    if (!a) return;
    var href = a.getAttribute('href') || '';
    if (!/wa\.me\/|api\.whatsapp\.com|^whatsapp:/.test(href)) return;
    var key = href + '|' + Math.floor(Date.now() / 2000);
    if (sent[key]) return;
    sent[key] = true;
    sendGoogle(a.href || href);
    try { if (typeof fbq === 'function') fbq('trackCustom', 'WhatsAppClick', { link_url: href }); } catch (e) {}
    try {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'whatsapp_click',
        whatsapp_link: href,
        page_path: location.pathname,
        wa_ref: typeof window.lavWaRef === 'function' ? window.lavWaRef() : ''
      });
    } catch (e) {}
  }, true);
})();
</script>
