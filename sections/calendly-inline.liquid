{%- comment -%}
  Calendrier Calendly intégré (page Contact, future /pages/rendez-vous).
  Chargé quand le bloc approche de l'écran ; la hauteur est ensuite pilotée
  par Calendly (resize: true) : ne jamais forcer height en CSS !important.
  Chargement et suivi calendly_booked : assets/calendly-booking.js.
{%- endcomment -%}
{{ 'calendly-booking.css' | asset_url | stylesheet_tag }}
<script src="{{ 'calendly-booking.js' | asset_url }}" defer="defer"></script>

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width lav-cal-inline section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="h2 lav-cal-inline__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte lav-cal-inline__text">{{ section.settings.text }}</div>
    {%- endif -%}
    <div
      class="lav-cal-inline__box"
      data-calendly-inline
      data-url="{{ section.settings.calendly_url }}"
      data-source="{{ section.settings.source | default: 'contact_inline' }}"
      style="min-width:300px;height:700px"
    >
      <noscript><a href="{{ section.settings.calendly_url }}" target="_blank" rel="noopener">Réserver un appel conseil</a></noscript>
    </div>
  </div>
</div>

<style>
  .section-{{ section.id }}-padding { padding-top: 3rem; padding-bottom: 3rem; }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding { padding-top: 4rem; padding-bottom: 4rem; }
  }
  .lav-cal-inline__title { text-align: center; margin: 0 0 1rem; }
  .lav-cal-inline__text { text-align: center; max-width: 60rem; margin: 0 auto 1.5rem; opacity: .85; }
  .lav-cal-inline__box iframe { display: block; width: 100%; }
</style>

<script>
  (function () {
    var box = document.querySelector('.section-{{ section.id }}-padding [data-calendly-inline]');
    if (!box) return;
    var started = false;
    function start() {
      if (started) return;
      started = true;
      (function go() {
        // calendly-booking.js est en defer : on attend qu'il soit prêt.
        if (!window.lavCalInline) return setTimeout(go, 100);
        window.lavCalInline(box).catch(function () {});
      })();
    }
    function near() { return box.getBoundingClientRect().top < window.innerHeight + 600; }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        if (entries.some(function (x) { return x.isIntersecting; })) { start(); io.disconnect(); }
      }, { rootMargin: '600px 0px' });
      io.observe(box);
    }
    // Filet de sécurité si l'observateur ne se déclenche pas (vu dans certains
    // navigateurs intégrés) : contrôle au défilement, au toucher et au chargement.
    function check() { if (!started && near()) start(); }
    window.addEventListener('scroll', check, { passive: true });
    box.addEventListener('pointerenter', start, { once: true });
    box.addEventListener('touchstart', start, { once: true, passive: true });
    if (document.readyState === 'complete') check(); else window.addEventListener('load', check);
  })();
</script>

{% schema %}
{
  "name": "Calendly (intégré)",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Préférez un appel ? Un conseiller vous rappelle" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>15 min, gratuit et sans engagement : compatibilité avec votre véhicule, choix des matériaux, délai et prix. Nous vous appelons sur WhatsApp ou par téléphone à l'heure choisie.</p>" },
    { "type": "text", "id": "calendly_url", "label": "Lien de l'événement Calendly", "default": "https://calendly.com/lamkademr/appel-conseiller-volant-15-min" },
    { "type": "text", "id": "source", "label": "Source (suivi)", "default": "contact_inline" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Couleurs", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Calendly (intégré)" }]
}
{% endschema %}
