{% comment %}
  Bandeau promotionnel défilant — campagne « L'Été Grand Tourisme »
  Les As du Volant

  À placer dans le groupe « header », en remplacement du bandeau d'annonce.

  Principe :
  - chaque bloc « message » est une accroche différente ; elles s'enchaînent
    dans le ruban, ce qui évite l'effet de répétition d'un message unique ;
  - le ruban est dupliqué à l'identique et animé de 0 à -50 % : la boucle est
    donc parfaitement continue, sans JavaScript ;
  - le ruban visuel est aria-hidden, une copie unique lisible est fournie aux
    lecteurs d'écran (sinon le message est répété N fois à la synthèse vocale).

  Lien : par défaut on pointe vers /discount/<CODE>?redirect=<cible>, l'URL
  Shopify qui pré-applique le code dans la session. Le client n'a donc jamais
  à saisir le code à la main — c'est le principal point de friction supprimé.
{% endcomment %}

{{ 'promo-ete150.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign messages = section.blocks | where: 'type', 'message'
  assign has_messages = false
  if messages.size > 0
    assign has_messages = true
  endif

  # Un groupe doit rester plus large que l'écran, sinon la boucle
  # (translation de -50 %) laisse apparaître un vide. Les items étant
  # largement espacés, ~10 suffisent à couvrir un très grand écran : c'est
  # le minimum de répétitions compatible avec une boucle continue.
  assign repeat = 10 | divided_by: messages.size
  if repeat < 2
    assign repeat = 2
  endif

  if section.settings.discount_code != blank
    assign target = section.settings.link | default: '/collections/all'
    assign promo_href = '/discount/' | append: section.settings.discount_code | append: '?redirect=' | append: target
  else
    assign promo_href = section.settings.link
  endif
-%}

{%- if has_messages -%}
  <div
    class="promo-marquee"
    style="--promo-marquee-duration: {{ section.settings.scroll_speed }}s;"
    role="region"
    aria-label="Offre en cours"
  >
    {%- if promo_href != blank -%}<a class="promo-marquee__link" href="{{ promo_href }}">{%- endif -%}

    <div class="promo-marquee__track" aria-hidden="true">
      {%- comment -%} Deux groupes identiques = boucle sans raccord. {%- endcomment -%}
      {%- for pass in (1..2) -%}
        <div class="promo-marquee__group">
          {%- for r in (1..repeat) -%}
            {%- for block in messages -%}
              <span
                class="promo-marquee__item{% if block.settings.highlight %} promo-marquee__item--highlight{% endif %}"
                {%- comment -%}
                  shopify_attributes sur la première occurrence seulement :
                  l'éditeur de thème doit cibler un élément unique par bloc.
                {%- endcomment -%}
                {% if pass == 1 and r == 1 %}{{ block.shopify_attributes }}{% endif %}
              >
                {{ block.settings.text }}
              </span>
              <span class="promo-marquee__separator"></span>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>

    {%- comment -%} Copie unique et lisible pour les technologies d'assistance. {%- endcomment -%}
    <span class="visually-hidden">
      {%- for block in messages -%}{{ block.settings.text | strip_html }}. {% endfor -%}
    </span>

    {%- if promo_href != blank -%}</a>{%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau promo défilant",
  "class": "promo-marquee-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "header",
      "content": "Offre"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Code de réduction à pré-appliquer",
      "info": "Le clic sur le bandeau active le code automatiquement (le client n'a rien à saisir). Laisser vide pour un lien simple.",
      "default": "ETE150"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Page de destination",
      "info": "Par défaut : /collections/all"
    },
    {
      "type": "header",
      "content": "Apparence"
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 30,
      "max": 180,
      "step": 10,
      "unit": "s",
      "label": "Durée d'un cycle",
      "info": "Plus la valeur est élevée, plus le défilement est lent et lisible.",
      "default": 110
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "150 € offerts dès 1 000 € d'achat"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "Mettre en champagne",
          "info": "À réserver au message porteur de l'offre.",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau promo défilant",
      "blocks": [
        { "type": "message", "settings": { "text": "150 € offerts dès 1 000 € d'achat", "highlight": true } },
        { "type": "message", "settings": { "text": "Jusqu'au 31 août" } }
      ]
    }
  ]
}
{% endschema %}
