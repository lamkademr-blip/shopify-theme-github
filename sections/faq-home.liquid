{% comment %}
  FAQ homepage — accordéon d'objections + balisage schema.org FAQPage.
  Les réponses doivent rester alignées avec la page /pages/foire-aux-questions.
{% endcomment %}

{% style %}
  .faq-home-{{ section.id }} {
    max-width: 900px;
    margin: 0 auto;
    padding: {{ section.settings.padding_top }}px clamp(24px, 4vw, 56px) {{ section.settings.padding_bottom }}px;
  }

  .faq-home-{{ section.id }} .faq-home__heading {
    text-align: center;
    margin: 0 0 8px;
  }

  .faq-home-{{ section.id }} .faq-home__subheading {
    text-align: center;
    margin: 0 0 40px;
    opacity: 0.7;
    font-size: 16px;
  }

  .faq-home-{{ section.id }} details {
    border-bottom: 1px solid rgba(18, 18, 18, 0.12);
  }

  .faq-home-{{ section.id }} details:first-of-type {
    border-top: 1px solid rgba(18, 18, 18, 0.12);
  }

  .faq-home-{{ section.id }} summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    padding: 22px 4px;
  }

  .faq-home-{{ section.id }} summary::-webkit-details-marker {
    display: none;
  }

  .faq-home-{{ section.id }} summary:focus-visible {
    outline: 2px solid #C9A96E;
    outline-offset: 2px;
  }

  .faq-home-{{ section.id }} .faq-home__question {
    margin: 0;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.01em;
  }

  .faq-home-{{ section.id }} .faq-home__icon {
    flex: 0 0 auto;
    width: 12px;
    height: 12px;
    position: relative;
  }

  .faq-home-{{ section.id }} .faq-home__icon::before,
  .faq-home-{{ section.id }} .faq-home__icon::after {
    content: "";
    position: absolute;
    background: currentColor;
    inset: 0;
    margin: auto;
  }

  .faq-home-{{ section.id }} .faq-home__icon::before {
    width: 12px;
    height: 1.5px;
  }

  .faq-home-{{ section.id }} .faq-home__icon::after {
    width: 1.5px;
    height: 12px;
    transition: transform 0.25s ease;
  }

  .faq-home-{{ section.id }} details[open] .faq-home__icon::after {
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-home-{{ section.id }} .faq-home__icon::after {
      transition: none;
    }
  }

  .faq-home-{{ section.id }} .faq-home__answer {
    padding: 0 32px 22px 4px;
    font-size: 15px;
    line-height: 1.7;
    opacity: 0.85;
    max-width: 72ch;
  }

  .faq-home-{{ section.id }} .faq-home__answer p {
    margin: 0 0 10px;
  }

  .faq-home-{{ section.id }} .faq-home__answer p:last-child {
    margin-bottom: 0;
  }

  .faq-home-{{ section.id }} .faq-home__footer {
    text-align: center;
    margin-top: 36px;
  }

  .faq-home-{{ section.id }} .faq-home__link {
    color: inherit;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-underline-offset: 4px;
  }

  .faq-home-{{ section.id }} .faq-home__link:hover {
    color: #C9A96E;
  }

  @media screen and (max-width: 749px) {
    .faq-home-{{ section.id }} summary {
      padding: 18px 2px;
    }

    .faq-home-{{ section.id }} .faq-home__question {
      font-size: 15.5px;
    }

    .faq-home-{{ section.id }} .faq-home__answer {
      padding-right: 8px;
    }
  }
{% endstyle %}

<div class="faq-home-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="faq-home__heading h2">{{ section.settings.heading }}</h2>
  {% endif %}
  {% if section.settings.subheading != blank %}
    <p class="faq-home__subheading">{{ section.settings.subheading }}</p>
  {% endif %}

  {% for block in section.blocks %}
    <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
      <summary>
        <h3 class="faq-home__question">{{ block.settings.question }}</h3>
        <span class="faq-home__icon" aria-hidden="true"></span>
      </summary>
      <div class="faq-home__answer">{{ block.settings.answer }}</div>
    </details>
  {% endfor %}

  {% if section.settings.link_label != blank and section.settings.link_url != blank %}
    <div class="faq-home__footer">
      <a class="faq-home__link" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
    </div>
  {% endif %}
</div>

{% if section.blocks.size > 0 %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% for block in section.blocks %}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "FAQ homepage",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Questions fréquentes"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sous-titre"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Ouvrir la première question par défaut",
      "default": false
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Libellé du lien bas de section",
      "default": "Toutes les questions"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Lien bas de section"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding haut",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bas",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ homepage"
    }
  ]
}
{% endschema %}
