{% comment %}
  Section matériaux — macros cuir / alcantara / carbone (DA carbone & champagne).
  Bloc éditorial sombre qui « justifie le prix » par la matière.
{% endcomment %}

<style>
  .materiaux-edito {
    background: #121212;
    color: #f7f6f4;
    padding: 88px 0;
  }
  .materiaux-edito__inner {
    max-width: 120rem;
    margin: 0 auto;
    padding: 0 3rem;
  }
  .materiaux-edito__eyebrow {
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #c9a96e;
    margin: 0 0 14px;
    text-align: center;
  }
  .materiaux-edito__heading {
    font-family: var(--font-heading-family), sans-serif;
    font-weight: 400;
    font-size: clamp(26px, 3.2vw, 38px);
    line-height: 1.15;
    color: #ffffff;
    text-align: center;
    margin: 0 auto 56px;
    max-width: 22ch;
  }
  .materiaux-edito__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .materiaux-edito__card { text-align: left; }
  .materiaux-edito__media {
    aspect-ratio: 1;
    overflow: hidden;
    margin-bottom: 20px;
  }
  .materiaux-edito__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease-out;
  }
  .materiaux-edito__card:hover .materiaux-edito__media img {
    transform: scale(1.03);
  }
  .materiaux-edito__name {
    font-family: var(--font-heading-family), sans-serif;
    font-weight: 400;
    font-size: 19px;
    letter-spacing: 0.02em;
    color: #ffffff;
    margin: 0 0 8px;
  }
  .materiaux-edito__text {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(247, 246, 244, 0.72);
    margin: 0;
    max-width: 34ch;
  }
  .materiaux-edito__cta {
    display: block;
    width: fit-content;
    margin: 52px auto 0;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c9a96e;
    text-decoration: none;
    border-bottom: 1px solid rgba(201, 169, 110, 0.45);
    padding-bottom: 4px;
    transition: border-color 0.15s ease-out;
  }
  .materiaux-edito__cta:hover {
    border-color: #c9a96e;
  }
  @media screen and (max-width: 749px) {
    .materiaux-edito { padding: 60px 0; }
    .materiaux-edito__inner { padding: 0 1.5rem; }
    .materiaux-edito__grid { grid-template-columns: 1fr; gap: 36px; }
    .materiaux-edito__heading { margin-bottom: 40px; }
    .materiaux-edito__text { max-width: none; }
  }
</style>

<div class="materiaux-edito">
  <div class="materiaux-edito__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="materiaux-edito__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="materiaux-edito__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="materiaux-edito__grid">
      {% for block in section.blocks %}
        <div class="materiaux-edito__card" {{ block.shopify_attributes }}>
          {% if block.settings.image %}
            <div class="materiaux-edito__media">
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900' }}
            </div>
          {% endif %}
          {% if block.settings.title != blank %}
            <h3 class="materiaux-edito__name">{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p class="materiaux-edito__text">{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.cta_label != blank %}
      <a class="materiaux-edito__cta" href="{{ section.settings.cta_link | default: '/collections/all' }}">{{ section.settings.cta_label }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Matériaux (éditorial)",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Les matières" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce que vos mains ressentiront" },
    { "type": "text", "id": "cta_label", "label": "Libellé du lien", "default": "Composer le vôtre" },
    { "type": "url", "id": "cta_link", "label": "Lien" }
  ],
  "blocks": [
    {
      "type": "materiau",
      "name": "Matériau",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image macro" },
        { "type": "text", "id": "title", "label": "Nom du matériau" },
        { "type": "textarea", "id": "text", "label": "Description" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    { "name": "Matériaux (éditorial)", "blocks": [{ "type": "materiau" }, { "type": "materiau" }, { "type": "materiau" }] }
  ]
}
{% endschema %}
